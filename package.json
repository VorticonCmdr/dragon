    "papaparse": "^5.4.1",
    "tabulator-tables": "^6.3.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "postcss": "^8.4.47",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
